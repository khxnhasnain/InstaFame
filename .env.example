# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Admin Whitelist
ADMIN_EMAILS=your_email@gmail.com,admin@viralora.com
NEXT_PUBLIC_ADMIN_EMAILS=your_email@gmail.com,admin@viralora.com

# instagrapi Credentials & Settings
IG_USERNAME=your_test_account
IG_PASSWORD=your_test_password
SECRET_KEY=your_secret_key
CACHE_TTL=3600
MIN_DELAY=3
MAX_DELAY=8

# Python FastAPI Backend URL
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# MySQL Database Configuration (XAMPP / MySQL Server)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=Viralora_db

# Dedicated Internal Server-to-Server Secret (Do NOT expose to client)
INTERNAL_API_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# UPI Manual Wallet Deposit Configuration
UPI_ID=8591365203@naviaxis
UPI_DISPLAY_NAME=Viralora Media
MIN_DEPOSIT_AMOUNT=100.00
MAX_DEPOSIT_AMOUNT=50000.00
MAX_PENDING_DEPOSITS_PER_USER=3
